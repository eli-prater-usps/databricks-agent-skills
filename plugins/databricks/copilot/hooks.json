{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/hooks/databricks-context.py\"",
        "powershell": "python \"$env:PLUGIN_ROOT/hooks/databricks-context.py\""
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "(?i)bash|shell|terminal",
        "bash": "python3 \"${PLUGIN_ROOT}/hooks/databricks-auth-helper.py\"",
        "powershell": "python \"$env:PLUGIN_ROOT/hooks/databricks-auth-helper.py\""
      }
    ]
  }
}
